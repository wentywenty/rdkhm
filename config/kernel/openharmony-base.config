# First-stage Linux facilities; OH-specific drivers are added separately.
CONFIG_LOCALVERSION="-rdkhm"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ANDROID_BINDER_IPC=y
# OH init/ueventd uses legacy Binder misc devices; no binderfs mount is provided.
# CONFIG_ANDROID_BINDERFS is not set
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ACCESS_TOKENID=y
CONFIG_ASHMEM=y
CONFIG_DRIVERS_HDF=y
CONFIG_HDF_SUPPORT_LEVEL=2
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,integrity,bpf"
CONFIG_AUDIT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_INPUT_EVDEV=y
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_FUSE_FS=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_DRM=y
CONFIG_DRM_VERISILICON=y
CONFIG_VERISILICON_X5_SYSCON_BRIDGE=y
CONFIG_DRM_SII902X=y
CONFIG_DRM_LONTIUM_LT8618=y
# CONFIG_VERISILICON_GC_PROC_SUPPORT is not set
