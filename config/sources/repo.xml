<?xml version="1.0" encoding="UTF-8"?>
<!--
  repo manifest for every upstream outside the full OpenHarmony tree:
  RDK kernel/BSP/wireless and the OpenHarmony kernel/HDF dependency checkouts.
  The full OpenHarmony tree is a separate repo workspace under
  sources/oh/openharmony-full, pinned by config/sources/openharmony.lock.xml.
  camsys is a sibling project because repo cannot nest projects inside
  x5-kernel; scripts/fetch-sources.sh links it into the kernel tree.
-->
<manifest>
  <remote name="drobotics" fetch="https://github.com/D-Robotics" />
  <remote name="openharmony" fetch="https://gitcode.com/openharmony" />
  <default sync-j="8" />

  <project path="rdk/x5-kernel" name="x5-kernel" remote="drobotics"
           revision="b2edb450c6eaef1c7277885d49f74efb6088b634" />
  <project path="rdk/x5-drv-camsys" name="x5-drv-camsys" remote="drobotics"
           revision="22c7c2e870622fe779d832ef1753b27191772cdd" />
