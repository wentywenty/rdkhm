           revision="9ebc13c76c4dfe14410537b4c1b0761d51d1ab9e" />
  <project path="rdk/x5-hobot-multimedia" name="x5-hobot-multimedia" remote="drobotics"
           revision="0f297df905511c3429567202813359acee26dbb3" />
  <project path="oh/manifest" name="manifest" remote="openharmony"
