root {
    module = "default";
    device_info {
        match_attr = "hdf_manager";
        nnrt :: host {
            hostName = "nnrt_host";
            priority = 50;
            gid = ["system", "graphics"];
            nnrt_device :: device {
                device0 :: deviceNode {
                    policy = 2;
                    priority = 50;
                    preload = 0;
                    moduleName = "libnnrt_driver.z.so";
                    serviceName = "nnrt_device_service";
                }
            }
        }
    }
}
