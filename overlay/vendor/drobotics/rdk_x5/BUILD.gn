import("//build/ohos.gni")
import("//build/config/components/init/param/param_fixer.gni")

ohos_prebuilt_etc("init.rdk_x5.cfg") {
  source = "init.rdk_x5.cfg"
  part_name = "product_rdk_x5"
  install_images = [ "vendor" ]
}

ohos_prebuilt_para("rdk_x5_param") {
  source = "default.para"
  module_install_dir = "etc/param"
  part_name = "product_rdk_x5"
  install_images = [ "vendor" ]
}

group("board_files") {
  deps = [
    ":fstab.rdk_x5",
    ":ueventd.config",
    "hdf_config/uhdf:hdf_config",
    "audio:audio_config",
    "//device/board/drobotics/rdk_x5/nearlink:rdkhm_ssap",
    "image_conf:image_conf",
    "stubs:stubs",
    ":desktop_config",
    ":rdkhm-usb",
    ":init.rdk_x5.cfg",
    ":rdk_x5_param",
  ]
}

group("desktop_config") {
  deps = []
  foreach(name, [ "install_list", "uninstall_list", "install_list_capability", "install_list_permissions" ]) {
    deps += [ ":${name}" ]
  }
}

# These files describe the same-release prebuilt HAPs, not RK3568 hardware.
foreach(name, [ "install_list", "uninstall_list", "install_list_capability", "install_list_permissions" ]) {
  ohos_prebuilt_etc(name) {
    source = "//vendor/drobotics/rdk_x5/preinstall-config/${name}.json"
    relative_install_dir = "app"
    part_name = "product_rdk_x5"
  }
}

ohos_prebuilt_etc("rdkhm-usb") {
  source = "rdkhm-usb.sh"
  module_install_dir = "bin"
  part_name = "product_rdk_x5"
  install_images = [ "vendor" ]
}

ohos_prebuilt_etc("fstab.rdk_x5") {
  source = "fstab.rdk_x5"
  part_name = "product_rdk_x5"
  install_images = [ "vendor" ]
}

ohos_prebuilt_etc("ueventd.config") {
  source = "ueventd.config"
  part_name = "product_rdk_x5"
  install_images = [ "vendor" ]
}
