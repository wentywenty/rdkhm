root {
    module = "default";
    device_info {
        match_attr = "hdf_manager";
        template host {
            hostName = "";
            priority = 100;
            uid = "root";
            gid = ["root"];
            caps = [""];
            template device {
                template deviceNode {
                    policy = 2;
                    priority = 100;
                    preload = 0;
                    permission = 0664;
                    moduleName = "";
                    serviceName = "";
                    deviceMatchAttr = "";
                }
            }
        }
        audio :: host {
            hostName = "audio_host";
            priority = 50;
            gid = ["audio_host", "uhdf_driver", "audio"];
            audio_primary :: device {
                device0 :: deviceNode {
                    moduleName = "libaudio_primary_driver.z.so";
                    serviceName = "audio_manager_service";
                }
            }
        }
        usb_serial :: host {
            hostName = "usb_serial_host";
            priority = 50;
            sandbox = 0;
            initconfig = ["\"secon\" : \"u:r:su:s0\""];
            usb_serial_device :: device {
                device0 :: deviceNode {
                    moduleName = "libusb_serial_ddk_driver.z.so";
                    serviceName = "usb_serial_ddk_service";
                }
            }
        }
        wlan :: host {
            hostName = "wifi_host";
            priority = 50;
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH", "NET_ADMIN", "NET_RAW"];
            gid = ["wifi_host", "wifi_group"];
            wifi_device :: device {
                device0 :: deviceNode {
                    moduleName = "libwifi_hdi_c_device.z.so";
                    serviceName = "wlan_interface_service";
                }
            }
            wifi_chip_device :: device {
                device0 :: deviceNode {
                    moduleName = "libchip_hdi_driver.z.so";
                    serviceName = "chip_interface_service";
                }
            }
        }
        wpa :: host {
            hostName = "wpa_host";
            priority = 50;
            uid = "wifi";
            gid = ["wifi", "wifi_group", "wifi_host"];
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH", "NET_ADMIN", "NET_RAW"];
            initconfig = ["\"permission\" : [\"ohos.permission.ACCESS_CERT_MANAGER\"]"];
            wpa_device :: device {
                device0 :: deviceNode {
                    preload = 2;
                    moduleName = "libwpa_hdi_c_device.z.so";
                    serviceName = "wpa_interface_service";
                }
            }
        }
        hostapd :: host {
            hostName = "hostapd_host";
            priority = 50;
            uid = "wifi";
            gid = ["wifi", "wifi_group", "wifi_host"];
            caps = ["DAC_OVERRIDE", "DAC_READ_SEARCH", "NET_ADMIN", "NET_RAW"];
            hostapd_device :: device {
                device0 :: deviceNode {
                    preload = 2;
                    moduleName = "libhostapd_hdi_c_device.z.so";
                    serviceName = "hostapd_interface_service";
                }
            }
        }
        display_composer :: host {
            hostName = "composer_host";
            priority = 40;
            uid = "composer_host";
            gid = ["composer_host", "graphics"];
            caps = ["SYS_NICE", "SYS_ADMIN"];
            composer_device :: device {
                device0 :: deviceNode {
                    moduleName = "libdisplay_composer_driver_1.0.z.so";
                    serviceName = "display_composer_service";
                }
            }
        }
        allocator :: host {
            hostName = "allocator_host";
            priority = 40;
            gid = ["root", "graphics"];
            allocator_device :: device {
                device0 :: deviceNode {
                    moduleName = "liballocator_driver_1.0.z.so";
                    serviceName = "allocator_service";
                }
            }
        }
        power :: host {
            hostName = "power_host";
            priority = 50;
            uid = "power_host";
            gid = ["power_host", "system"];
            initconfig = ["\"secon\" : \"u:r:power_host:s0\""];
            power_device :: device {
                device0 :: deviceNode {
                    moduleName = "libpower_driver.z.so";
                    serviceName = "power_interface_service";
                }
            }
        }
        // The common USB camera VDI is built by drivers_peripheral_camera.
        // Register its HDI host here; without this device node the generated
        // camera_host_config.hcb is never consumed by the HDF devhost.
        camera :: host {
            hostName = "camera_host";
            priority = 50;
            gid = ["camera_host", "uhdf_driver"];
            camera_device :: device {
                device0 :: deviceNode {
                    policy = 2;
                    priority = 100;
                    moduleName = "libcamera_host_service_1.0.z.so";
                    serviceName = "camera_service";
                }
            }
        }
        pin_auth :: host {
            hostName = "pin_auth_host";
            priority = 50;
            uid = "pin_auth_host";
            gid = ["pin_auth_host", "useriam"];
            initconfig = ["\"secon\" : \"u:r:pin_auth_host:s0\""];
            pin_auth_device :: device {
                device0 :: deviceNode {
                    policy = 2;
                    priority = 200;
                    moduleName = "libpin_auth_driver.z.so";
                    serviceName = "pin_auth_interface_service";
                }
            }
        }

        nnrt :: host {
            hostName = "nnrt_host";
            priority = 50;
            uid = "system";
            gid = ["system", "graphics"];
            initconfig = ["\"secon\" : \"u:r:nnrt_host:s0\""];
            nnrt_device :: device {
                device0 :: deviceNode {
                    policy = 2;
                    priority = 50;
                    preload = 0;
                    moduleName = "libnnrt_driver.z.so";
                    serviceName = "nnrt_device_service";
                }
            }
        }
    }
}
