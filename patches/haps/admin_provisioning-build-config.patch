diff --git a/entry/src/main/ets/MainAbility/UIExtensionAbility.ets b/entry/src/main/ets/MainAbility/UIExtensionAbility.ets
index c2ff48d..c9862a0 100644
--- a/entry/src/main/ets/MainAbility/UIExtensionAbility.ets
+++ b/entry/src/main/ets/MainAbility/UIExtensionAbility.ets
@@ -24,6 +24,26 @@ import { BusinessError } from '@ohos.base';
 
 const TAG = 'AutoDeployAbility';
 
+interface ProvisionAdminConfig {
+  abilityName: string;
+  bundleName: string;
+}
+
+interface ProvisionAdminInfo {
+  admin: ProvisionAdminConfig;
+  admin_type: string;
+}
+
+interface ProvisionEnterpriseInfo {
+  organization_name: string;
+  description: string;
+}
+
+interface ProvisionConfig {
+  admin_info: ProvisionAdminInfo[];
+  enterprise_info: ProvisionEnterpriseInfo;
+}
+
 export default class AutoDeployAbility extends UIExtensionAbility {
   private localStorage: LocalStorage = new LocalStorage();
 
@@ -37,7 +57,7 @@ export default class AutoDeployAbility extends UIExtensionAbility {
       name: '',
       description: ''
     };
-    let adminType: adminManager.AdminType;
+    let adminType: adminManager.AdminType = adminManager.AdminType.ADMIN_TYPE_NORMAL;
     try {
       let realpath = 'etc/edm/edm_provision_config.json';
       await configPolicy.getOneCfgFile(realpath).then((value: string) => {
@@ -45,7 +65,7 @@ export default class AutoDeployAbility extends UIExtensionAbility {
         let configStr = fs.readTextSync(value);
         logger.info(TAG, 'getOneCfgFile configStr is ' + JSON.stringify(configStr));
         if (configStr) {
-          let jsonArray = JSON.parse(configStr);
+          let jsonArray = JSON.parse(configStr) as ProvisionConfig;
           admin.abilityName = jsonArray.admin_info[0].admin.abilityName;
           admin.bundleName = jsonArray.admin_info[0].admin.bundleName;
           enterpriseInfo.name = jsonArray.enterprise_info.organization_name;
diff --git a/entry/src/main/ets/pages/applicationInfo.ets b/entry/src/main/ets/pages/applicationInfo.ets
index 40adb2e..a320b4d 100644
--- a/entry/src/main/ets/pages/applicationInfo.ets
+++ b/entry/src/main/ets/pages/applicationInfo.ets
@@ -251,21 +251,24 @@ struct ApplicationInfo {
   }
 
   async isAdminActive() {
+    const bundleName = elementNameVal.bundleName;
+    const abilityName = elementNameVal.abilityName;
+    if (!bundleName || !abilityName ||
+      bundleName === baseData.EMPTY_STR || abilityName === baseData.EMPTY_STR) {
+      logger.info(TAG, 'isAdminActive elementNameVal is null');
+      return;
+    }
     let wantTemp: Want = {
-      bundleName: elementNameVal.bundleName,
-      abilityName: elementNameVal.abilityName,
+      bundleName: bundleName,
+      abilityName: abilityName,
     };
     let retAppState: boolean;
     let retSuperState: boolean;
-    logger.info(TAG, 'isAdminActive elementNameVal.bundleName=' + elementNameVal.bundleName +
-    ' | elementNameVal.abilityName=' + elementNameVal.abilityName);
-    if (elementNameVal.bundleName === baseData.EMPTY_STR || elementNameVal.abilityName === baseData.EMPTY_STR) {
-      logger.info(TAG, 'isAdminActive elementNameVal is null');
-      return;
-    }
+    logger.info(TAG, 'isAdminActive elementNameVal.bundleName=' + bundleName +
+    ' | elementNameVal.abilityName=' + abilityName);
 
     retAppState = await edmEnterpriseDeviceManager.isAdminEnabled(wantTemp);
-    let name: string = elementNameVal.bundleName;
+    let name: string = bundleName;
     retSuperState = await edmEnterpriseDeviceManager.isSuperAdmin(name);
     if (!retAppState) {
       this.isShowActive = false;
@@ -335,6 +338,11 @@ struct ApplicationInfo {
     logger.info(TAG, 'getAbilityWantVal in:');
     this.storage = LocalStorage.getShared();
     let data = this.storage.get<Want>('adminProvisioningWant');
+    if (data === undefined) {
+      logger.warn(TAG, 'adminProvisioningWant is undefined');
+      (getContext(this) as common.UIAbilityContext).terminateSelf();
+      return;
+    }
 
     if (!utils.checkObjPropertyValid(data, 'parameters.elementName.abilityName') ||
     !utils.checkObjPropertyValid(data, 'parameters.enterprise.name') ||
