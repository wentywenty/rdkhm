+++ b/entry/src/main/ets/pages/autoManager/managerStart.ets
@@ -179,6 +179,11 @@ struct ManagerStart {
   parseManageParameter() {
     this.storage = LocalStorage.getShared();
     let data = this.storage.get<Want>('autoManagerAbilityWant');
+    if (data === undefined) {
+      logger.error(TAG, 'autoManagerAbilityWant is undefined');
+      (getContext(this) as common.UIAbilityContext).terminateSelf();
+      return;
+    }
 
     if (!utils.checkObjPropertyValid(data, 'parameters.elementName.abilityName') ||
     !utils.checkObjPropertyValid(data, 'parameters.enterprise.name') ||
diff --git a/entry/src/main/ets/pages/component/deployComponent.ets b/entry/src/main/ets/pages/component/deployComponent.ets
index d0fa8dc..5a8f810 100644
--- a/entry/src/main/ets/pages/component/deployComponent.ets
+++ b/entry/src/main/ets/pages/component/deployComponent.ets
@@ -266,10 +266,16 @@ export struct deployComponent {
   }
 
   private EnableAdmin() {
+    if (!this.abilityInfo || !this.enterpriseInfo || this.adminType === undefined) {
+      logger.error(TAG, 'enableAdmin missing admin, enterprise or admin type');
+      this.terminateAbility(baseData.ENABLE_ADMIN_FAILED);
+      return;
+    }
     let admin: Want = this.abilityInfo;
     let entInfo: adminManager.EnterpriseInfo = this.enterpriseInfo;
+    let adminType: adminManager.AdminType = this.adminType;
     try {
-      adminManager.enableAdmin(admin, entInfo, this.adminType).then(() => {
+      adminManager.enableAdmin(admin, entInfo, adminType).then(() => {
         logger.info(TAG, 'enableAdmin success');
         this.terminateAbility(baseData.OOBE_NEXT_STEP_CODE);
       }).catch((err: BusinessError) => {
