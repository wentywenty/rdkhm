+++ b/common/utils/src/main/ets/default/baseUtil/RdbStoreUtil.ets
@@ -40,19 +40,195 @@
 const TAG: string = 'RdbStoreUtil';
 
 const FileMaxSize: number = 20 * 1024 * 1024;
+const LocalStoreFileName: string = 'notes.json';
 let rdbStore = AppStorage.Get<relationalStore.RdbStore>('rdbStore');
+
+interface LocalStoreData {
+  folders: FolderData[];
+  notes: NoteData[];
+}
 
 /**
  * db instance
  */
 class RdbStoreUtil {
+  private localFilePath(): string {
+    let context = AppStorage.Get<common.UIAbilityContext>('noteContext');
+    if (context == undefined || context == null) {
+      return '';
+    }
+    return context.filesDir + '/' + LocalStoreFileName;
+  }
+
+  private loadLocalData(): boolean {
+    let path = this.localFilePath();
+    if (path.length == 0) {
+      return false;
+    }
+    try {
+      fileio.accessSync(path);
+      let text = fileio.readTextSync(path);
+      let data = JSON.parse(text) as LocalStoreData;
+      if (data == undefined || data.folders == undefined || data.notes == undefined ||
+        data.folders.length == 0) {
+        return false;
+      }
+      let folders: FolderData[] = [];
+      data.folders.forEach((item) => {
+        folders.push(new FolderData(item.id, item.name, item.uuid, item.color, item.folder_type,
+          item.is_deleted, item.created_time, item.modified_time));
+      });
+      let notes: NoteData[] = [];
+      data.notes.forEach((item) => {
+        notes.push(new NoteData(item.id, item.title, item.uuid, item.folder_uuid, item.content_text,
+          item.content_img, item.note_type, item.is_top, item.is_favorite, item.is_deleted,
+          item.created_time, item.modified_time, item.deleted_time, item.slider_value));
+      });
+      let selectedFolder = FolderUtil.getFolderData(folders, SysDefFolderUuid.AllNotes);
+      if (selectedFolder == undefined) {
+        selectedFolder = folders[0];
+      }
+      AppStorage.SetOrCreate('AllFolderArray', folders)
+      AppStorage.SetOrCreate('AllNoteArray', notes)
+      AppStorage.SetOrCreate('Folder', selectedFolder)
+      AppStorage.SetOrCreate('Note', NoteUtil.getFirstNoteData(notes, selectedFolder.uuid))
+      AppStorage.SetOrCreate('Section', 3)
+      AppStorage.SetOrCreate('DBQueryFinished', 1)
+      LogUtil.info(TAG, 'loadLocalData success, notes: ' + notes.length)
+      return true;
+    } catch (err) {
+      LogUtil.warn(TAG, 'loadLocalData failed : ' + err)
+      return false;
+    }
+  }
+
+  private saveLocalData(): void {
+    let path = this.localFilePath();
+    if (path.length == 0) {
+      return;
+    }
+    let folders = AppStorage.Get<FolderData[]>('AllFolderArray');
+    let notes = AppStorage.Get<NoteData[]>('AllNoteArray');
+    if (folders == undefined || notes == undefined) {
+      return;
+    }
+    let data: LocalStoreData = {
+      folders: folders,
+      notes: notes
+    };
+    try {
+      let fd = fileio.openSync(path, 0o2 | 0o100, 0o600);
+      fileio.writeSync(fd, JSON.stringify(data));
+      fileio.closeSync(fd);
+    } catch (err) {
+      LogUtil.error(TAG, 'saveLocalData failed : ' + err)
+    }
+  }
+
+  saveNote(noteData: NoteData): void {
+    let notes = AppStorage.Get<NoteData[]>('AllNoteArray');
+    if (notes != undefined) {
+      let index = notes.findIndex((item) => item.uuid == noteData.uuid);
+      if (index >= 0) {
+        notes[index] = noteData;
+      }
+    }
+    this.saveLocalData();
+  }
+
+  private openStore(context: common.UIAbilityContext): Promise<relationalStore.RdbStore> {
+    return new Promise<relationalStore.RdbStore>((resolve, reject) => {
+      relationalStore.getRdbStore(context, SysDefData.dbInfo.db_name,
+        (err: BusinessError, store: relationalStore.RdbStore) => {
+          if (err) {
+            reject(err);
+          } else {
+            resolve(store);
+          }
+        });
+    });
+  }
+
+  private async ensureSchema(store: relationalStore.RdbStore): Promise<void> {
+    await store.executeSql(TableSql.FolderTableSQL.toString(), null);
+    await store.executeSql(TableSql.NoteTableSQL.toString(), null);
+    await store.executeSql(TableSql.AttachmentTableSQL.toString(), null);
+    await store.executeSql(TableSql.FormTableSQL.toString(), null);
+  }
+
+  private async seedDefaultData(store: relationalStore.RdbStore): Promise<void> {
+    let resultSet = await store.query(new relationalStore.RdbPredicates(TableName.FolderTable), [FolderTableColumn.Id]);
+    let hasFolder = resultSet.goToNextRow();
+    resultSet.close();
+    if (hasFolder) {
+      return;
+    }
+    let sysDefFolderArray = [SysDefData.sys_def_allNotes, SysDefData.sys_def_unClassified,
+      SysDefData.sys_def_myFavorites, SysDefData.sys_def_recentDeletes,
+      SysDefData.sys_def_personal, SysDefData.sys_def_life, SysDefData.sys_def_work];
+    for (let sysDefFolder of sysDefFolderArray) {
+      await store.insert(TableName.FolderTable, sysDefFolder);
+    }
+    let sysDefNoteArray = [SysDefData.sys_def_note1, SysDefData.sys_def_note2,
+      SysDefData.sys_def_note3, SysDefData.sys_def_note4];
+    for (let sysDefNote of sysDefNoteArray) {
+      await store.insert(TableName.NoteTable, sysDefNote);
+    }
+    LogUtil.info(TAG, "seedDefaultData success")
+  }
+
+  private setDefaultState(): void {
+    let folderDataArray: FolderData[] = [];
+    let sysDefFolderArray = [SysDefData.sys_def_allNotes, SysDefData.sys_def_unClassified,
+      SysDefData.sys_def_myFavorites, SysDefData.sys_def_recentDeletes,
+      SysDefData.sys_def_personal, SysDefData.sys_def_life, SysDefData.sys_def_work];
+    sysDefFolderArray.forEach((sysDefFolder) => {
+      let folderData = new FolderData(sysDefFolder.id as number, sysDefFolder.name as string, sysDefFolder.uuid as string, sysDefFolder.color as string,
+        sysDefFolder.folder_type as FolderType, sysDefFolder.is_deleted as Delete, sysDefFolder.created_time as number,
+        sysDefFolder.modified_time as number);
+      folderDataArray.push(folderData);
+    })
+    let noteDataArray: NoteData[] = [];
+    let sysDefNoteArray = [SysDefData.sys_def_note1, SysDefData.sys_def_note2,
+      SysDefData.sys_def_note3, SysDefData.sys_def_note4];
+    sysDefNoteArray.forEach((sysDefNote) => {
+      let noteData = new NoteData(sysDefNote.id as number, sysDefNote.title as string, sysDefNote.uuid as string, sysDefNote.folder_uuid as string,
+        sysDefNote.content_text as string, sysDefNote.content_img as string, sysDefNote.note_type as NoteType, sysDefNote.is_top as Top,
+        sysDefNote.is_favorite as Favorite, sysDefNote.is_deleted as Delete, sysDefNote.created_time as number,
+        sysDefNote.modified_time as number, sysDefNote.deleted_time as number, sysDefNote.slider_value as number);
+      noteDataArray.push(noteData);
+    })
+    AppStorage.SetOrCreate('AllFolderArray', folderDataArray)
+    AppStorage.SetOrCreate('AllNoteArray', noteDataArray)
+    AppStorage.SetOrCreate('Folder', folderDataArray[0])
+    AppStorage.SetOrCreate('Note', NoteUtil.getFirstNoteData(noteDataArray, SysDefFolderUuid.AllNotes))
+    AppStorage.SetOrCreate('Section', 3)
+    AppStorage.SetOrCreate('DBQueryFinished', 1)
+  }
+
+  createRdbStore(context: common.UIAbilityContext) {
+    this.initAppStorage(context)
+  }
+
+  initAppStorage(context: common.UIAbilityContext) {
+    this.setDefaultState()
+    if (this.loadLocalData()) {
+      return
+    }
+    this.saveLocalData()
+  }
+
