From: wentywenty <2321901849@qq.com>
Subject: [PATCH] libnl/0001-use-installed-host-tools.patch

Signed-off-by: wentywenty <2321901849@qq.com>
---
--- a/install.sh
+++ b/install.sh
@@ -14,8 +14,12 @@ fi
 tar xvf libnl-libnl3_11_0.tar.gz
 mv libnl-libnl3_11_0 libnl
 cd $1/libnl
-apt-get update
-apt-get install autoconf automake libtool -y
+for tool in autoconf automake libtoolize; do
+    command -v "$tool" >/dev/null || {
+        echo "Required host tool is missing: $tool" >&2
+        exit 1
+    }
+done
 ./autogen.sh
 ./configure
 patch -p1 < $1/solve-oh-compile-problem3_11_0.patch --fuzz=0 --no-backup-if-mismatch
