     const std::shared_ptr<const RSRenderNode>& node)
 {
+    if (!RSRenderNode::IsDrawableGenerationEnabled()) {
+        return nullptr;
+    }
     if (node == nullptr) {
         ROSEN_LOGE("RSRenderNodeDrawableAdapter::OnGenerate, node null");
         return nullptr;
--- a/rosen/modules/render_service_base/src/platform/ohos/rs_render_service_client.cpp
+++ b/rosen/modules/render_service_base/src/platform/ohos/rs_render_service_client.cpp
@@ -48,6 +48,7 @@
 #include "platform/common/rs_log.h"
 #include "platform/common/rs_system_properties.h"
 #include "render/rs_typeface_cache.h"
+#include "pipeline/rs_render_node.h"
 #include "rs_render_service_connect_hub.h"
 #include "rs_surface_ohos.h"
 #include "vsync_iconnection_token.h"
@@ -59,7 +60,10 @@
 std::shared_ptr<RSIRenderClient> RSIRenderClient::CreateRenderServiceClient()
 {
     static std::once_flag once_flag;
-    std::call_once(once_flag, []() { client_ = std::make_shared<RSRenderServiceClient>(); });
+    std::call_once(once_flag, []() {
+        RSRenderNode::SetDrawableGenerationEnabled(false);
+        client_ = std::make_shared<RSRenderServiceClient>();
+    });
     return client_;
 }
 
