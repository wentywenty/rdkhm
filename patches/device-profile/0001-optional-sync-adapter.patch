From: wentywenty <2321901849@qq.com>
Subject: [PATCH] device-profile/0001-optional-sync-adapter.patch

Signed-off-by: wentywenty <2321901849@qq.com>
---
--- a/services/core/src/deviceprofilemanager/device_profile_manager.cpp
+++ b/services/core/src/deviceprofilemanager/device_profile_manager.cpp
@@ -545,7 +545,7 @@
         so_handle = dlopen(soName.c_str(), RTLD_NOW);
     }
     if (so_handle == nullptr) {
-        HILOGE("load dp sync adapter so %{public}s failed", soName.c_str());
+        HILOGW("optional dp sync adapter so %{public}s not present", soName.c_str());
         return false;
     }
     dlerror();
