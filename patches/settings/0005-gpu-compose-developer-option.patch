+import ConfigData from '../../../../../../../common/utils/src/main/ets/default/baseUtil/ConfigData';
+import ISettingsController from '../../../../../../../common/component/src/main/ets/default/controller/ISettingsController';
+import SwitchController from '../../../../../../../common/component/src/main/ets/default/controller/SwitchController';
+import LogUtil from '../../../../../../../common/utils/src/main/ets/default/baseUtil/LogUtil';
+import { LogAll } from '../../../../../../../common/utils/src/main/ets/default/baseUtil/LogDecorator';
+import parameter from '@ohos.systemparameter';
+
+const MODULE_TAG = ConfigData.TAG + '.GpuComposeController -> ';
+const GPU_COMPOSE_PARAM = 'persist.rdkhm.gpu.compose';
+
+@LogAll
+export default class GpuComposeController extends SwitchController {
+  initData(): ISettingsController {
+    super.initData();
+    return this;
+  }
+
+  afterCurrentValueChanged() {
+    parameter.set(GPU_COMPOSE_PARAM, this.isOn ? '1' : '0').then(() => {
+      LogUtil.info(MODULE_TAG + (this.isOn ? 'enable gpu compose success' : 'disable gpu compose success'));
+    }).catch((error) => {
+      LogUtil.info(MODULE_TAG + 'set gpu compose failed ' + JSON.stringify(error));
+    });
+  }
+}
