+ * limitations under the License.
+ */
+
+import usbManager from '@ohos.usbManager';
+import parameter from '@ohos.systemparameter';
+import LogUtil from '../../../../../../common/utils/src/main/ets/default/baseUtil/LogUtil';
+import ConfigData from '../../../../../../common/utils/src/main/ets/default/baseUtil/ConfigData';
+import HeadComponent from '../../../../../../common/component/src/main/ets/default/headComponent';
+
+const TAG = ConfigData.TAG + 'NearLink: ';
+const NEARLINK_USB_VENDOR_ID = 0xFFFF;
+const NEARLINK_USB_PRODUCT_ID = 0x3733;
+
+@Entry
+@Component
+struct NearLink {
+  @State usbPresent: boolean = false;
+  @State frameworkReady: boolean = false;
+  @State probeFailed: boolean = false;
+
+  aboutToAppear(): void {
+    this.frameworkReady =
+      parameter.getSync('const.SystemCapability.Communication.NearLink', 'false') === 'true';
+    LogUtil.info(TAG + `frameworkReady ${this.frameworkReady}`);
+
+    try {
+      const devices = usbManager.getDevices();
+      for (let index = 0; index < devices.length; index++) {
+        const device = devices[index];
+        if (device.vendorId === NEARLINK_USB_VENDOR_ID && device.productId === NEARLINK_USB_PRODUCT_ID) {
+          this.usbPresent = true;
+          break;
+        }
+      }
+      LogUtil.info(TAG + `usbPresent ${this.usbPresent}`);
+    } catch (err) {
+      this.probeFailed = true;
+      LogUtil.error(TAG + 'usb query failed: ' + JSON.stringify(err));
+    }
+  }
+
+  build() {
+    Column() {
+      GridContainer({ gutter: ConfigData.GRID_CONTAINER_GUTTER_24, margin: ConfigData.GRID_CONTAINER_MARGIN_24 }) {
+        Column() {
+          HeadComponent({ headName: $r('app.string.nearlinkTab'), isActive: true });
+          Column() {
+            Row() {
+              Text($r('app.string.nearlinkUsbTitle'))
+                .fontSize($r('app.float.font_14'))
+                .fontColor($r('sys.color.ohos_id_color_text_primary'))
+                .fontWeight(FontWeight.Medium)
+              Blank()
+              Text(this.usbPresent ? $r('app.string.nearlinkPresent') : $r('app.string.nearlinkAbsent'))
+                .fontSize($r('app.float.font_14'))
+                .fontColor($r('sys.color.ohos_id_color_text_secondary'))
+            }
+            .width(ConfigData.WH_100_100)
+            .height($r('app.float.wh_value_56'))
+            .padding({ left: $r('app.float.wh_value_12'), right: $r('app.float.wh_value_12') })
+            .alignItems(VerticalAlign.Center)
+
+            Divider()
+              .strokeWidth(1)
+              .color($r('sys.color.ohos_id_color_list_separator'))
+              .margin({ left: $r('app.float.wh_value_12'), right: $r('app.float.wh_value_12') })
+
+            Row() {
+              Text($r('app.string.nearlinkFrameworkTitle'))
+                .fontSize($r('app.float.font_14'))
+                .fontColor($r('sys.color.ohos_id_color_text_primary'))
+                .fontWeight(FontWeight.Medium)
+              Blank()
+              Text(this.frameworkReady ? $r('app.string.nearlinkReady') : $r('app.string.nearlinkNotReady'))
+                .fontSize($r('app.float.font_14'))
+                .fontColor($r('sys.color.ohos_id_color_text_secondary'))
+            }
+            .width(ConfigData.WH_100_100)
+            .height($r('app.float.wh_value_56'))
+            .padding({ left: $r('app.float.wh_value_12'), right: $r('app.float.wh_value_12') })
+            .alignItems(VerticalAlign.Center)
+
+            Divider()
+              .strokeWidth(1)
+              .color($r('sys.color.ohos_id_color_list_separator'))
+              .margin({ left: $r('app.float.wh_value_12'), right: $r('app.float.wh_value_12') })
+
+            Row() {
+              Text($r('app.string.nearlinkDriverTitle'))
+                .fontSize($r('app.float.font_14'))
+                .fontColor($r('sys.color.ohos_id_color_text_primary'))
+                .fontWeight(FontWeight.Medium)
+              Blank()
+              Text($r('app.string.nearlinkManual'))
+                .fontSize($r('app.float.font_14'))
+                .fontColor($r('sys.color.ohos_id_color_text_secondary'))
+            }
+            .width(ConfigData.WH_100_100)
+            .height($r('app.float.wh_value_56'))
+            .padding({ left: $r('app.float.wh_value_12'), right: $r('app.float.wh_value_12') })
+            .alignItems(VerticalAlign.Center)
+
+            if (this.probeFailed) {
+              Divider()
+                .strokeWidth(1)
+                .color($r('sys.color.ohos_id_color_list_separator'))
+                .margin({ left: $r('app.float.wh_value_12'), right: $r('app.float.wh_value_12') })
+
+              Row() {
+                Text($r('app.string.nearlinkProbeFailed'))
+                  .fontSize($r('app.float.font_14'))
+                  .fontColor($r('sys.color.ohos_id_color_text_primary'))
+                  .fontWeight(FontWeight.Medium)
+              }
+              .width(ConfigData.WH_100_100)
+              .height($r('app.float.wh_value_56'))
+              .padding({ left: $r('app.float.wh_value_12'), right: $r('app.float.wh_value_12') })
+              .alignItems(VerticalAlign.Center)
+            }
+          }
+          .borderRadius($r("app.float.radius_16"))
+          .backgroundColor($r("app.color.white_bg_color"))
+          .width(ConfigData.WH_100_100)
+          .margin({ top: $r("app.float.distance_12") })
+          .padding({
+            top: $r("app.float.distance_4"),
+            bottom: $r("app.float.distance_4")
+          })
+
+          Text($r('app.string.nearlinkTips'))
+            .fontFamily('HarmonyHeiTi')
+            .fontWeight(FontWeight.Regular)
+            .fontSize($r("app.float.font_14"))
+            .lineHeight($r("app.float.lineHeight_19"))
+            .fontColor($r("sys.color.ohos_id_color_text_secondary"))
+            .opacity($r("app.float.opacity_100_60"))
+            .margin({
+              top: $r("app.float.distance_12"),
+              left: $r("app.float.wh_value_12"),
+              right: $r("app.float.wh_value_12")
+            })
+        }
+        .useSizeType({
+          sm: { span: 4, offset: 0 },
+          md: { span: 6, offset: 1 },
+          lg: { span: 8, offset: 2 }
+        })
+      }
+      .width(ConfigData.WH_100_100)
+      .height(ConfigData.WH_100_100)
+    }
+    .backgroundColor($r("sys.color.ohos_id_color_sub_background"))
+    .width(ConfigData.WH_100_100)
+    .height(ConfigData.WH_100_100)
+  }
+}
