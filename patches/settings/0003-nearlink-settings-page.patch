diff --git a/product/phone/src/main/ets/pages/nearlink.ets b/product/phone/src/main/ets/pages/nearlink.ets
new file mode 100644
index 0000000..b469a31
--- /dev/null
+++ b/product/phone/src/main/ets/pages/nearlink.ets
@@ -0,0 +1,168 @@
+/**
