+bool ReadOfflineModelFile(const char* path, std::vector<uint8_t>& data)
+{
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    if (!file.is_open()) {
+        LOGE("[NNBackend] CreateCompiler failed, cannot open offline model file.");
+        return false;
+    }
+
+    const std::streampos end = file.tellg();
+    if (end <= 0) {
+        LOGE("[NNBackend] CreateCompiler failed, offline model file is empty.");
+        return false;
+    }
+
+    data.resize(static_cast<size_t>(end));
+    file.seekg(0, std::ios::beg);
+    if (!file.read(reinterpret_cast<char*>(data.data()), static_cast<std::streamsize>(end))) {
+        LOGE("[NNBackend] CreateCompiler failed, cannot read offline model file.");
+        data.clear();
+        return false;
+    }
+    return true;
+}
