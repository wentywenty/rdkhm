+OH_NN_DataType TransHDIToNNDataType(const V2_1::DataType& dataType)
+{
+    switch (dataType) {
+        case V2_1::DataType::DATA_TYPE_BOOL:
+            return OH_NN_BOOL;
+        case V2_1::DataType::DATA_TYPE_INT8:
+            return OH_NN_INT8;
+        case V2_1::DataType::DATA_TYPE_INT16:
+            return OH_NN_INT16;
+        case V2_1::DataType::DATA_TYPE_INT32:
+            return OH_NN_INT32;
+        case V2_1::DataType::DATA_TYPE_INT64:
+            return OH_NN_INT64;
+        case V2_1::DataType::DATA_TYPE_UINT8:
+            return OH_NN_UINT8;
+        case V2_1::DataType::DATA_TYPE_UINT16:
+            return OH_NN_UINT16;
+        case V2_1::DataType::DATA_TYPE_UINT32:
+            return OH_NN_UINT32;
+        case V2_1::DataType::DATA_TYPE_UINT64:
+            return OH_NN_UINT64;
+        case V2_1::DataType::DATA_TYPE_FLOAT16:
+            return OH_NN_FLOAT16;
+        case V2_1::DataType::DATA_TYPE_FLOAT32:
+            return OH_NN_FLOAT32;
+        case V2_1::DataType::DATA_TYPE_FLOAT64:
+            return OH_NN_FLOAT64;
+        default:
+            return OH_NN_UNKNOWN;
+    }
+}
+
+OH_NN_Format TransHDIToNNFormat(const V2_1::Format& format)
+{
+    switch (format) {
+        case V2_1::Format::FORMAT_NCHW:
+            return OH_NN_FORMAT_NCHW;
+        case V2_1::Format::FORMAT_NHWC:
+            return OH_NN_FORMAT_NHWC;
+        default:
+            return OH_NN_FORMAT_NONE;
+    }
+}
+
+OH_NN_ReturnCode ConvertHDITensorToDesc(const V2_1::Tensor& tensor, size_t index, bool isInput,
+    std::pair<std::shared_ptr<TensorDesc>, OH_NN_TensorType>& tensorDesc)
+{
+    auto desc = CreateSharedPtr<TensorDesc>();
+    if (desc == nullptr) {
+        LOGE("Create tensor desc failed when converting offline model IO.");
+        return OH_NN_MEMORY_ERROR;
+    }
+
+    OH_NN_DataType dataType = TransHDIToNNDataType(tensor.dataType);
+    OH_NN_ReturnCode ret = desc->SetDataType(dataType);
+    if (ret != OH_NN_SUCCESS) {
+        LOGE("Set offline model tensor data type failed, dataType: %{public}d.",
+            static_cast<int32_t>(dataType));
+        return ret;
+    }
+
+    ret = desc->SetFormat(TransHDIToNNFormat(tensor.format));
+    if (ret != OH_NN_SUCCESS) {
+        return ret;
+    }
+
+    if (tensor.dims.empty()) {
+        LOGE("Offline model tensor %{public}zu has empty dimensions.", index);
+        return OH_NN_INVALID_PARAMETER;
+    }
+    ret = desc->SetShape(tensor.dims.data(), tensor.dims.size());
+    if (ret != OH_NN_SUCCESS) {
+        return ret;
+    }
+
+    std::string name = tensor.name;
+    if (name.empty()) {
+        name = (isInput ? "input" : "output") + std::to_string(index);
+    }
+    ret = desc->SetName(name.c_str());
+    if (ret != OH_NN_SUCCESS) {
+        return ret;
+    }
+
+    tensorDesc = std::make_pair(std::move(desc), OH_NN_TENSOR);
+    return OH_NN_SUCCESS;
+}
