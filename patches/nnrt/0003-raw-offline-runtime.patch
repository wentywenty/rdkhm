+OH_NN_ReturnCode NNCompiler::BuildRawOfflineModel()
+{
+    if (m_offlineModel.empty()) {
+        LOGE("[NNCompiler] Build failed, raw offline model is empty.");
+        return OH_NN_INVALID_PARAMETER;
+    }
+
+    OH_NN_ReturnCode ret = m_device->GetOfflineModelIO(m_offlineModel.data(), m_offlineModel.size(),
+        m_inputTensorDescs, m_outputTensorDescs);
+    if (ret != OH_NN_SUCCESS) {
+        LOGE("[NNCompiler] Build failed, fail to get IO tensor descriptors of offline model: %{public}d.",
+            static_cast<int32_t>(ret));
+        return ret;
+    }
+
+    if (m_inputTensorDescs.empty() || m_outputTensorDescs.empty()) {
+        LOGE("[NNCompiler] Build failed, offline model returns empty IO tensor descriptors.");
+        return OH_NN_INVALID_PARAMETER;
+    }
+
+    ModelConfig config {m_enableFp16, m_performance, m_priority, m_cachePath, m_extensionConfig};
+    ret = m_device->PrepareOfflineModel(m_offlineModel.data(), m_offlineModel.size(), config,
+        m_preparedModel);
+    if (ret != OH_NN_SUCCESS) {
+        LOGE("[NNCompiler] Build failed, fail to prepare raw offline model: %{public}d.",
+            static_cast<int32_t>(ret));
+        return ret;
+    }
+
+    m_isBuild = true;
+    return OH_NN_SUCCESS;
+}
