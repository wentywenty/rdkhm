+OH_NN_ReturnCode HDIDeviceV2_1::PrepareOfflineModel(const void* model, size_t modelSize,
+                                                    const ModelConfig& config,
+                                                    std::shared_ptr<PreparedModel>& preparedModel)
+{
+    if (model == nullptr || modelSize == 0) {
+        LOGE("Raw offline model is empty.");
+        return OH_NN_INVALID_PARAMETER;
+    }
+
+    void* deviceBuffer = AllocateBuffer(modelSize);
+    if (deviceBuffer == nullptr) {
+        LOGE("Allocate buffer for raw offline model failed.");
+        return OH_NN_MEMORY_ERROR;
+    }
+    if (memcpy_s(deviceBuffer, modelSize, model, modelSize) != EOK) {
+        (void)ReleaseBuffer(deviceBuffer);
+        LOGE("Copy raw offline model to device buffer failed.");
+        return OH_NN_MEMORY_ERROR;
+    }
+
+    auto memManager = MemoryManager::GetInstance();
+    Memory memory;
+    OH_NN_ReturnCode ret = memManager->GetMemory(deviceBuffer, memory);
+    if (ret != OH_NN_SUCCESS) {
+        (void)ReleaseBuffer(deviceBuffer);
+        LOGE("Retrieve raw offline model device memory failed.");
+        return ret;
+    }
+
+    V2_1::ModelConfig iModelConfig;
+    iModelConfig.enableFloat16 = config.enableFloat16;
+    iModelConfig.mode = TransPerformanceMode(config.mode);
+    iModelConfig.priority = TransPriority(config.priority);
+    V2_1::SharedBuffer iBuffer {memory.fd, memory.length, 0, memory.length};
+    OHOS::sptr<V2_1::IPreparedModel> iPreparedModel;
+    auto preparedRet = m_iDevice->PrepareOfflineModel({iBuffer}, iModelConfig, iPreparedModel);
+
+    (void)ReleaseBuffer(deviceBuffer);
+
+    if (preparedRet != V2_1::NNRT_ReturnCode::NNRT_SUCCESS || iPreparedModel == nullptr) {
+        return CheckReturnCode_V2_1(preparedRet, OH_NN_FAILED, "Prepare raw offline model failed");
+    }
+
+    preparedModel = CreateSharedPtr<HDIPreparedModelV2_1>(iPreparedModel);
+    if (preparedModel == nullptr) {
+        LOGE("Create prepared model for raw offline model failed.");
+        return OH_NN_MEMORY_ERROR;
+    }
+    return OH_NN_SUCCESS;
+}
+
+OH_NN_ReturnCode HDIDeviceV2_1::GetOfflineModelIO(
+    const void* model, size_t modelSize,
+    std::vector<std::pair<std::shared_ptr<TensorDesc>, OH_NN_TensorType>>& inputs,
+    std::vector<std::pair<std::shared_ptr<TensorDesc>, OH_NN_TensorType>>& outputs)
+{
+    if (model == nullptr || modelSize == 0) {
+        LOGE("Raw offline model is empty.");
+        return OH_NN_INVALID_PARAMETER;
+    }
+
+    void* deviceBuffer = AllocateBuffer(modelSize);
+    if (deviceBuffer == nullptr) {
+        LOGE("Allocate buffer for raw offline model IO query failed.");
+        return OH_NN_MEMORY_ERROR;
+    }
+    if (memcpy_s(deviceBuffer, modelSize, model, modelSize) != EOK) {
+        (void)ReleaseBuffer(deviceBuffer);
+        LOGE("Copy raw offline model to device buffer failed.");
+        return OH_NN_MEMORY_ERROR;
+    }
+
+    auto memManager = MemoryManager::GetInstance();
+    Memory memory;
+    OH_NN_ReturnCode ret = memManager->GetMemory(deviceBuffer, memory);
+    if (ret != OH_NN_SUCCESS) {
+        (void)ReleaseBuffer(deviceBuffer);
+        LOGE("Retrieve raw offline model device memory failed.");
+        return ret;
+    }
+
+    V2_1::SharedBuffer iBuffer {memory.fd, memory.length, 0, memory.length};
+    std::vector<V2_1::Tensor> iInputs;
+    std::vector<V2_1::Tensor> iOutputs;
+    auto queryRet = m_iDevice->GetOfflineModelIO(iBuffer, iInputs, iOutputs);
+    (void)ReleaseBuffer(deviceBuffer);
+
+    if (queryRet != V2_1::NNRT_ReturnCode::NNRT_SUCCESS) {
+        return CheckReturnCode_V2_1(queryRet, OH_NN_FAILED, "Get offline model IO failed");
+    }
+
+    inputs.clear();
+    outputs.clear();
+    for (size_t i = 0; i < iInputs.size(); i++) {
+        std::pair<std::shared_ptr<TensorDesc>, OH_NN_TensorType> inputDesc;
+        ret = ConvertHDITensorToDesc(iInputs[i], i, true, inputDesc);
+        if (ret != OH_NN_SUCCESS) {
+            return ret;
+        }
+        inputs.emplace_back(std::move(inputDesc));
+    }
+    for (size_t i = 0; i < iOutputs.size(); i++) {
+        std::pair<std::shared_ptr<TensorDesc>, OH_NN_TensorType> outputDesc;
+        ret = ConvertHDITensorToDesc(iOutputs[i], i, false, outputDesc);
+        if (ret != OH_NN_SUCCESS) {
+            return ret;
+        }
+        outputs.emplace_back(std::move(outputDesc));
+    }
+
+    return OH_NN_SUCCESS;
+}
