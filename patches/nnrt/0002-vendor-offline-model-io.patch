From: RDKHM <rdkhm@localhost>
Subject: [PATCH] nnrt/0002-vendor-offline-model-io.patch

Signed-off-by: RDKHM <rdkhm@localhost>
---
--- a/nnrt/v2_1/INnrtDevice.idl
+++ b/nnrt/v2_1/INnrtDevice.idl
@@ -224,6 +224,23 @@ interface INnrtDevice {
     PrepareOfflineModel([in] struct SharedBuffer[] offlineModels, [in] struct ModelConfig config,
                         [out] IPreparedModel preparedModel);
 
+    /**
+     * @brief Obtains the input and output tensor descriptors of an offline model.
+     *
+     * This is a vendor extension used by raw offline models whose tensor
+     * descriptors are stored in the model file instead of an NNRt graph.
+     *
+     * @param model Raw offline model file. For details, see {@link SharedBuffer}.
+     * @param inputs Input tensor descriptors of the offline model, in model order.
+     * @param outputs Output tensor descriptors of the offline model, in model order.
+     *
+     * @return Returns <b>0</b> if the operation is successful.
+     * @return Returns a non-0 value if the operation fails. A negative value is an HDF standard error code,\n
+     * and a positive value is a dedicated error code defined by NNRt. For details, see {@link NNRT_ReturnCode}.
+     */
+    GetOfflineModelIO([in] struct SharedBuffer model, [out] struct Tensor[] inputs,
+                      [out] struct Tensor[] outputs);
+
     /**
      * @brief Allocates the shared memory for the device. The shared memory allows quick access to the input\n
      * and output data for AI inference.
