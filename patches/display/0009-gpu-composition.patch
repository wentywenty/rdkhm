 #include <cerrno>
 #include "hdi_drm_layer.h"
 
@@ -50,6 +51,9 @@ int32_t HdiDrmComposition::SetLayers(std::vector<HdiLayer *> &layers, HdiLayer &
     DISPLAY_LOGD();
     mCompLayers.clear();
     mCompLayers.push_back(&clientLayer);
+    mClientLayer = &clientLayer;
+    mGpuLayers = layers;
+    mGpuComposed = false;
     return DISPLAY_SUCCESS;
 }
 
@@ -266,7 +270,7 @@ int32_t HdiDrmComposition::FindPlaneAndApply(drmModeAtomicReqPtr pset)
 
 int32_t HdiDrmComposition::Apply(bool modeSet)
 {
-    int32_t crtcOutFence = -1;
+    uint64_t crtcOutFence = static_cast<uint64_t>(-1);
     int ret = 0;
     std::unique_ptr<DrmModeBlock> modeBlock;
     int drmFd = mDrmDevice->GetDrmFd();
@@ -281,6 +285,18 @@ int32_t HdiDrmComposition::Apply(bool modeSet)
     ret = UpdateMode(pset, modeBlock);
     DISPLAY_CHK_RETURN(ret != DISPLAY_SUCCESS, ret, DISPLAY_LOGE("update mode failed"));
 
+#ifdef RDK_X5_SOFTWARE_COMPOSITION
+    if (!mGpuComposed && mClientLayer != nullptr && GpuComposeClient::Available() &&
+        GpuComposeClient::CanCompose(mGpuLayers, mClientLayer)) {
+        if (GpuComposeClient::Compose(mGpuLayers, mClientLayer) == 0) {
+            mGpuComposed = true;
+        } else {
+            GpuComposeClient::Disable();
+            DISPLAY_LOGE("gpu compose failed, falling back on later frames");
+        }
+    }
+#endif
+
     // set the outFence property
     ret = drmModeAtomicAddProperty(atomicReqPtr.Get(), mCrtc->GetId(), mCrtc->GetOutFencePropId(),
         (uint64_t)&crtcOutFence);
diff --git a/display/composer/vdi_base/src/hdi_gfx_composition.cpp b/display/composer/vdi_base/src/hdi_gfx_composition.cpp
index 6a15429..a08a653 100644
--- a/display/composer/vdi_base/src/hdi_gfx_composition.cpp
+++ b/display/composer/vdi_base/src/hdi_gfx_composition.cpp
@@ -14,6 +14,7 @@
  */
 
 #include "hdi_gfx_composition.h"
+#include "gpu_compose_client.h"
 #include <cinttypes>
 #include <dlfcn.h>
 #include <cerrno>
@@ -111,6 +112,14 @@ bool HdiGfxComposition::UseCompositionClient(std::vector<HdiLayer *> &layers)
 int32_t HdiGfxComposition::SetLayers(std::vector<HdiLayer *> &layers, HdiLayer &clientLayer)
 {
 #ifdef RDK_X5_SOFTWARE_COMPOSITION
+    if (GpuComposeClient::Available() && GpuComposeClient::CanCompose(layers, &clientLayer)) {
+        mClientLayer = &clientLayer;
+        mCompLayers.clear();
+        for (auto *layer : layers) {
+            layer->SetDeviceSelect(COMPOSITION_DEVICE);
+        }
+        return DISPLAY_SUCCESS;
+    }
     mClientLayer = &clientLayer;
     mCompLayers.clear();
     for (auto *layer : layers) {
