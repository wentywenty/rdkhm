+#ifndef GPU_COMPOSE_CLIENT_H
+#define GPU_COMPOSE_CLIENT_H
+
+#include <vector>
+#include "hdi_layer.h"
+
+namespace OHOS {
+namespace HDI {
+namespace DISPLAY {
+
+class GpuComposeClient {
+public:
+    static bool Available();
+    static bool CanCompose(const std::vector<HdiLayer *> &layers, HdiLayer *target);
+    static int32_t Compose(const std::vector<HdiLayer *> &layers, HdiLayer *target);
+    static void Disable();
+
+private:
+    static bool Probe();
+};
+
+} // DISPLAY
+} // HDI
+} // OHOS
+
+#endif
