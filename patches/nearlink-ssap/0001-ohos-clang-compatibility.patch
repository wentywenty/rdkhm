From: wentywenty <2321901849@qq.com>
Subject: [PATCH] nearlink-ssap/0001-ohos-clang-compatibility.patch

Signed-off-by: wentywenty <2321901849@qq.com>
---
--- a/src/ssap_server.c
+++ b/src/ssap_server.c
@@ -473,6 +473,7 @@ int ssap_server_dispatch(ssap_server_t *srv, const uint8_t *pdu, size_t len)
             off += 3;
             for (uint8_t s = 0; s < subCount && off + 3 <= len; s++) {
                 uint8_t subType = pdu[off++];
+                (void)subType;
                 uint16_t subLen = (uint16_t)(pdu[off] | ((uint16_t)pdu[off + 1] << 8));
                 off += 2;
                 if (off + subLen > len)
--- a/test/test_server.c
+++ b/test/test_server.c
@@ -13,6 +13,16 @@
 static int g_fail = 0;
 static uint8_t g_last_tx[256];
 static size_t g_last_tx_len = 0;
+static int method_called = 0;
+
+static int test_method(uint16_t h, const uint8_t *p, uint16_t pl,
+                       uint8_t *r, uint16_t *rl, uint16_t mr)
+{
+    (void)h; (void)p; (void)pl; (void)r; (void)mr;
+    *rl = 0;
+    method_called++;
+    return 0;
+}
 
 static int fake_send(const uint8_t *pdu, size_t len)
 {
@@ -261,12 +271,6 @@ int main(void)
 
     /* CALL_METHOD_REQ — invoke method handle */
     {
-        static int method_called = 0;
-        int test_method(uint16_t h, const uint8_t *p, uint16_t pl,
-                        uint8_t *r, uint16_t *rl, uint16_t mr) {
-            (void)h; (void)p; (void)pl; (void)r; (void)mr;
-            *rl = 0; method_called++; return 0;
-        }
         uint16_t mhandle = ssap_server_add_method(&srv, svc, 0x9999, 0x01, test_method);
         (void)mhandle;
         CHECK(mhandle != 0, "add method returns handle");
