     os.chdir(cur_dir)
 
 
+def uses_v26(cwd: str):
+    path = os.path.join(cwd, 'hvigor/hvigor-config.json5')
+    try:
+        with open(path, 'r') as input_f:
+            text = input_f.read()
+    except OSError:
+        return False
+    if 'command-line-tools-26' in text:
+        return True
+    try:
+        model_version = json5.loads(text).get('modelVersion')
+    except Exception:
+        return False
+    if not model_version:
+        return False
+    try:
+        return int(str(model_version).split('.')[0]) >= 6
+    except ValueError:
+        return False
+
+
 def get_integrated_project_config(cwd: str):
     print(f"[0/0] project dir: {cwd}")
     with open(os.path.join(cwd, 'hvigor/hvigor-config.json5'), 'r') as input_f:
@@ -232,7 +265,10 @@ def hvigor_write_log(cmd, cwd, env):
 def build_hvigor_cmd(cwd: str, model_version: str, options):
     cmd = ['bash']
     hvigor_version = get_hvigor_version(cwd)
-    if options.hvigor_home:
+    toolchain = os.environ.get("RDKHM_COMMAND_LINE_TOOLS") if uses_v26(cwd) else None
+    if toolchain:
+        cmd.extend([f'{os.path.abspath(toolchain)}/command-line-tools/bin/hvigorw'])
+    elif options.hvigor_home:
         cmd.extend([f'{os.path.abspath(options.hvigor_home)}/bin/hvigorw'])
     elif model_version:
         code_home = os.path.dirname(os.path.dirname(options.sdk_home))
@@ -330,6 +366,10 @@ def hvigor_build(cwd: str, options):
     model_version = get_integrated_project_config(cwd)
     print(f"[0/0] model_version: {model_version}")
 
+    use_v26 = uses_v26(cwd)
+    hvigor_sdk = os.environ.get("RDKHM_HVIGOR_SDK") if use_v26 else None
+    if hvigor_sdk:
+        options.sdk_home = hvigor_sdk
     cmd = build_hvigor_cmd(cwd, model_version, options)
 
     print("[0/0] Hvigor clean start")
@@ -337,6 +377,10 @@ def hvigor_build(cwd: str, options):
     env['CI'] = 'true'
     env['PATH'] = f"{os.path.dirname(os.path.abspath(options.nodejs))}:{os.environ.get('PATH')}"
     env['NODE_HOME'] = os.path.dirname(os.path.dirname(os.path.abspath(options.nodejs)))
+    if use_v26 and options.sdk_home:
+        env['OHOS_SDK_HOME'] = os.path.abspath(options.sdk_home)
+        env['OHOS_BASE_SDK_HOME'] = os.path.abspath(options.sdk_home)
+        env['DEVECO_SDK_HOME'] = os.path.abspath(options.sdk_home)
     library_path = os.path.join(os.path.abspath(options.sdk_home), '20/ets/ets1.2/build-tools/ets2panda/lib/')
     env['LD_LIBRARY_PATH'] = library_path
     set_sdk_path(cwd, model_version, options, env)
