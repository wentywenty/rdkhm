+ * The upstream CalendarData sample ships an empty build() because the page is
+ * normally generated from a low-code .visual file. No such file exists in this
+ * checkout, so the ability started with a blank window. Render a self-contained
+ * month grid instead; it only uses local Date arithmetic and needs no calendar
+ * database access.
  */
+class CalendarCell {
+  day: number;
+
+  constructor(day: number) {
+    this.day = day;
+  }
+}
+
+const WEEKDAYS: string[] = ['日', '一', '二', '三', '四', '五', '六'];
 
 @Entry
 @Component
 struct Index {
-  @State message: string = 'Hello World'
+  @State year: number = new Date().getFullYear();
+  @State month: number = new Date().getMonth();
+  @State today: number = new Date().getDate();
+  @State currentMonth: boolean = true;
+  @State cells: CalendarCell[] = [];
+
+  aboutToAppear(): void {
+    this.refresh();
+  }
+
+  private refresh(): void {
+    const firstWeekday: number = new Date(this.year, this.month, 1).getDay();
+    const days: number = new Date(this.year, this.month + 1, 0).getDate();
+    const list: CalendarCell[] = [];
+    for (let i: number = 0; i < firstWeekday; i++) {
+      list.push(new CalendarCell(0));
+    }
+    for (let day: number = 1; day <= days; day++) {
+      list.push(new CalendarCell(day));
+    }
+    while (list.length % 7 !== 0) {
+      list.push(new CalendarCell(0));
+    }
+    this.cells = list;
+    const now: Date = new Date();
+    this.currentMonth = now.getFullYear() === this.year && now.getMonth() === this.month;
+    this.today = now.getDate();
+  }
+
+  private shiftMonth(delta: number): void {
+    let nextMonth: number = this.month + delta;
+    let nextYear: number = this.year;
+    if (nextMonth < 0) {
+      nextMonth = 11;
+      nextYear -= 1;
+    } else if (nextMonth > 11) {
+      nextMonth = 0;
+      nextYear += 1;
+    }
+    this.year = nextYear;
+    this.month = nextMonth;
+    this.refresh();
+  }
+
+  private isToday(day: number): boolean {
+    return this.currentMonth && day === this.today;
+  }
+
+  private title(): string {
+    return `${this.year}年${this.month + 1}月`;
+  }
 
-  /**
-   * In low-code mode, do not add anything to the build function, as it will be
