new file mode 100644
index 000000000..49bdfbd75
--- /dev/null
+++ b/include/linux/memcheck.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ *  include/linux/memcheck.h
+ *
+ *  Copyright (c) 2022 Huawei Technologies Co., Ltd.
+ */
+#ifndef _MEMCHECK_H
+#define _MEMCHECK_H
