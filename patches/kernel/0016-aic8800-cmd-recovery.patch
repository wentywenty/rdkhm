From: wentywenty <2321901849@qq.com>
Subject: [PATCH] kernel/0016-aic8800-cmd-recovery.patch

Signed-off-by: wentywenty <2321901849@qq.com>
---
--- a/drivers/net/wireless/aic8800/aic8800_fdrv/aicwf_sdio.c
+++ b/drivers/net/wireless/aic8800/aic8800_fdrv/aicwf_sdio.c
@@ -3098,7 +3098,11 @@ void aicwf_sdio_release(struct aic_sdio_dev *sdiodev)
 	AICWFDBG(LOGINFO, "%s:pwrctl stopped\n", __func__);
 	#endif
 
-	if (sdiodev->cmd_mgr.state == RWNX_CMD_MGR_STATE_INITED)
+	/*
+	 * A CRASHED command manager still owns its workqueue; skipping deinit
+	 * leaks it and can leave work referencing a freed bus device.
+	 */
+	if (sdiodev->cmd_mgr.cmd_wq)
 		rwnx_cmd_mgr_deinit(&sdiodev->cmd_mgr);
 	AICWFDBG(LOGINFO, "%s Exit\n", __func__);
 }
--- a/drivers/net/wireless/aic8800/aic8800_fdrv/rwnx_cmds.c
+++ b/drivers/net/wireless/aic8800/aic8800_fdrv/rwnx_cmds.c
@@ -532,12 +532,15 @@ void rwnx_cmd_mgr_init(struct rwnx_cmd_mgr *cmd_mgr)
 	cmd_mgr->cmd_wq = create_singlethread_workqueue("cmd_wq");
 	if (!cmd_mgr->cmd_wq) {
 		txrx_err("insufficient memory to create cmd workqueue.\n");
+		cmd_mgr->state = RWNX_CMD_MGR_STATE_DEINIT;
 		return;
 	}
 }
 
 void rwnx_cmd_mgr_deinit(struct rwnx_cmd_mgr *cmd_mgr)
 {
+	if (!cmd_mgr->cmd_wq)
+		return;
 	cmd_mgr->print(cmd_mgr);
 	cmd_mgr->drain(cmd_mgr);
 	cmd_mgr->print(cmd_mgr);
--- a/drivers/net/wireless/aic8800/aic8800_fdrv/rwnx_main.c
+++ b/drivers/net/wireless/aic8800/aic8800_fdrv/rwnx_main.c
@@ -1052,6 +1052,22 @@ static int rwnx_open(struct net_device *dev)
 
 	RWNX_DBG(RWNX_FN_ENTRY_STR);
 
+	/*
+	 * A timed-out LMAC command puts the command manager in CRASHED and every
+	 * later command fails with -EPIPE.  The vendor flow expects userspace to
+	 * reload the driver on the DHDISDOWN uevent; OpenHarmony has no such
+	 * handler.  Recreate the queue so the next open can retry instead of
+	 * leaving the interface permanently unusable.  The caller is in process
+	 * context here, so draining the old workqueue is safe.
+	 */
+	if (rwnx_hw->cmd_mgr->state == RWNX_CMD_MGR_STATE_CRASHED) {
+		AICWFDBG(LOGERROR, "%s reinitializing crashed cmd queue\n", __func__);
+		rwnx_cmd_mgr_deinit(rwnx_hw->cmd_mgr);
+		rwnx_cmd_mgr_init(rwnx_hw->cmd_mgr);
+		if (rwnx_hw->cmd_mgr->state == RWNX_CMD_MGR_STATE_DEINIT)
+			return -ENOMEM;
+	}
+
 #ifdef CONFIG_WOWLAN
     rwnx_send_set_pkt_filter_req(rwnx_hw, wowlan_param1);
 #endif
@@ -1110,10 +1126,12 @@ static int rwnx_open(struct net_device *dev)
 				err = rwnx_send_add_if (rwnx_hw, rwnx_hw->p2p_dev_vif->wdev.address,
 											  RWNX_VIF_TYPE(rwnx_hw->p2p_dev_vif), false, &add_if_cfm);
 				if (err) {
+					clear_bit(RWNX_DEV_STARTED, &rwnx_vif->drv_flags);
 					return -EIO;
 				}
 
 				if (add_if_cfm.status != 0) {
+					clear_bit(RWNX_DEV_STARTED, &rwnx_vif->drv_flags);
 					return -EIO;
 				}
 
@@ -1154,11 +1172,13 @@ static int rwnx_open(struct net_device *dev)
 		 *     p2p value not used in FMAC configuration, iftype is sufficient */
 		error = rwnx_send_add_if (rwnx_hw, rwnx_vif->wdev.address, RWNX_VIF_TYPE(rwnx_vif), false, &add_if_cfm);
 		if (error) {
+			clear_bit(RWNX_DEV_STARTED, &rwnx_vif->drv_flags);
 			printk("add if fail\n");
 			return error;
 		}
 
 		if (add_if_cfm.status != 0) {
+			clear_bit(RWNX_DEV_STARTED, &rwnx_vif->drv_flags);
 			RWNX_PRINT_CFM_ERR(add_if);
 			return -EIO;
 		}
