From: wentywenty <2321901849@qq.com>
Subject: [PATCH] kernel/0002-builtin-display-bridge.patch

Signed-off-by: wentywenty <2321901849@qq.com>
---
--- a/drivers/gpu/drm/verisilicon/vs_drv.c
+++ b/drivers/gpu/drm/verisilicon/vs_drv.c
@@ -391,10 +391,12 @@ static int vs_drm_platform_of_probe(struct device *dev)
 		vs_drm. It is not the most elegant solution and should be improved.
 	*/
 
-	ret = request_module("vs_x5_syscon_bridge");
-	if (ret != 0) {
-		printk(KERN_ERR "Failed to load vs_x5_syscon_bridge\n");
-		return ret;
+	if (IS_MODULE(CONFIG_VERISILICON_X5_SYSCON_BRIDGE)) {
+		ret = request_module("vs_x5_syscon_bridge");
+		if (ret != 0) {
+			printk(KERN_ERR "Failed to load vs_x5_syscon_bridge\n");
+			return ret;
+		}
 	}
 
 	if (!np)
