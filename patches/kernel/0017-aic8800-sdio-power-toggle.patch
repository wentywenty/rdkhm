From: wentywenty <2321901849@qq.com>
Subject: [PATCH] kernel/0017-aic8800-sdio-power-toggle.patch

Signed-off-by: wentywenty <2321901849@qq.com>
---
--- a/arch/arm64/boot/dts/hobot/x5-rdk.dtsi
+++ b/arch/arm64/boot/dts/hobot/x5-rdk.dtsi
@@ -525,7 +525,7 @@
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_sdio &lsio_gpio0_6>;
 	power-gpios = <&ls_gpio0_porta 6 GPIO_ACTIVE_HIGH>;
-	toggle_interval_us = <20000>;
+	toggle_interval_us = <100000>;
 };
 
 &dc8000_nano {
