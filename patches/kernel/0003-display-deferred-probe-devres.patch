From: wentywenty <2321901849@qq.com>
Subject: [PATCH] kernel/0003-display-deferred-probe-devres.patch

Signed-off-by: wentywenty <2321901849@qq.com>
---
--- a/drivers/gpu/drm/verisilicon/dc/vs_dc.c
+++ b/drivers/gpu/drm/verisilicon/dc/vs_dc.c
@@ -334,6 +334,7 @@ err_clean:
 	list_for_each_entry_safe_reverse (dc_dev, tmp, &dc->aux_list, head) {
 		list_del(&dc_dev->head);
-		kfree(dc_dev);
+		/* Unlink the allocation from its owning device's devres list. */
+		devm_kfree(dc_dev->dev, dc_dev);
 	}
 	return ret;
 }
