From: rdkhm <rdkhm@local>
Subject: [PATCH] hdf_core: only descend into the kaihong audio directory when present

Signed-off-by: rdkhm <rdkhm@local>
---
--- a/adapter/khdf/linux/model/audio/Makefile
+++ b/adapter/khdf/linux/model/audio/Makefile
@@ -59,8 +59,13 @@ obj-$(CONFIG_DRIVERS_HDF_AUDIO_RK3568) += \
 obj-$(CONFIG_DRIVERS_HDF_AUDIO_RK3588) += \
           $(KHDF_AUDIO_BASE_ROOT_DIR)/device/board/hihope/dayu210/audio_drivers/
 
+# The kaihong board is not part of every product checkout; only descend into
+# its audio directory when it exists, otherwise `make clean` fails on the
+# missing path even though CONFIG_DRIVERS_HDF_AUDIO_RK3566 is disabled.
+ifneq ($(wildcard $(KHDF_AUDIO_BASE_ROOT_DIR)/device/board/kaihong/khdvk_3566b/kernel/audio/Makefile),)
 obj-$(CONFIG_DRIVERS_HDF_AUDIO_RK3566) += \
           $(KHDF_AUDIO_BASE_ROOT_DIR)/device/board/kaihong/khdvk_3566b/kernel/audio/
+endif
 
 obj-$(CONFIG_DRIVERS_HDF_AUDIO_A311D) += \
           $(KHDF_AUDIO_A311D_DIR)/codec/soc_codec/a311d_codec_adapter.o \
