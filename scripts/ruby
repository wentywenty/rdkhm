#!/usr/bin/env bash
set -euo pipefail
workspace=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
host="$workspace/out/host-tools/usr"
export LD_LIBRARY_PATH="$host/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export RUBYLIB="$host/lib/ruby/3.0.0:$host/lib/x86_64-linux-gnu/ruby/3.0.0:$host/lib/ruby/vendor_ruby:$host/lib/ruby/vendor_ruby/3.0.0"
exec "$host/bin/ruby3.0" "$@"
